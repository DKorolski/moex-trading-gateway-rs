[Unit]
Description=MOEX FINAM Stage 8B P1 paper supervisor
After=local-fs.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=moex-p1-paper
Group=moex-p1-paper
UMask=0077
LoadCredential=stage8b-p1-lifecycle.key:/etc/moex-finam-p1-paper/credentials/stage8b-p1-lifecycle.key
ExecStart=/usr/local/libexec/moex/stage8b-p1-paper-supervisor run /etc/moex-finam-p1-paper/supervisor.json
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=100s
FinalKillSignal=SIGKILL
SendSIGKILL=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateNetwork=no
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
IPAddressAllow=::1/128
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
LimitCORE=0
ReadOnlyPaths=/etc/moex-finam-p1-paper
ReadWritePaths=/var/lib/moex-finam-p1-paper/state
