{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moex-trading.invalid/schema/stage8b-p1e-i1a-semantic-identity-v1.json",
  "title": "Stage8bP1eScheduleSemanticIdentityV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "instrument",
    "registry",
    "trading_day",
    "timezone",
    "timeframe_sec",
    "sessions",
    "stage4_semantic_state"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "domain": {"const": "moex.stage8b.p1e.schedule-semantic-identity.v1"},
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "broker_symbol", "exchange", "market", "venue_mic", "board", "tick_size"],
      "properties": {
        "symbol": {"const": "IMOEXF"},
        "broker_symbol": {"const": "IMOEXF@RTSX"},
        "exchange": {"const": "moex"},
        "market": {"const": "futures"},
        "venue_mic": {"const": "RTSX"},
        "board": {"const": "FUT"},
        "tick_size": {"const": "0.5"}
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_version", "registry_identity_sha256"],
      "properties": {
        "registry_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "registry_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "trading_day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "timezone": {"const": "Europe/Moscow"},
    "timeframe_sec": {"const": 600},
    "sessions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/session"}
    },
    "stage4_semantic_state": {"$ref": "#/$defs/stage4SemanticState"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_type", "start_utc", "end_utc"],
      "properties": {
        "session_type": {"enum": ["tradable_open", "break_or_clearing", "maintenance"]},
        "start_utc": {"$ref": "#/$defs/utcTimestamp"},
        "end_utc": {"$ref": "#/$defs/utcTimestamp"}
      }
    },
    "stage4SemanticState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_kind", "schedule_state", "boundary_proof"],
          "properties": {
            "evidence_kind": {"const": "tradability"},
            "schedule_state": {"const": "open"},
            "boundary_proof": {"const": null}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_kind", "schedule_state", "boundary_proof"],
          "properties": {
            "evidence_kind": {"const": "day_boundary"},
            "schedule_state": {"const": "closed"},
            "boundary_proof": {"$ref": "#/$defs/boundaryProof"}
          }
        }
      ]
    },
    "boundaryProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trading_day", "boundary_ts_utc", "last_eligible_m10_open_ts_utc", "last_eligible_m10_close_ts_utc"],
      "properties": {
        "trading_day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "boundary_ts_utc": {"$ref": "#/$defs/utcTimestamp"},
        "last_eligible_m10_open_ts_utc": {"$ref": "#/$defs/utcTimestamp"},
        "last_eligible_m10_close_ts_utc": {"$ref": "#/$defs/utcTimestamp"}
      }
    }
  },
  "x_hash_contract": {
    "canonical_encoding": "strict-canonical-json-subset-v1",
    "hash_domain": "moex.stage8b.p1e.schedule-semantic-identity.sha256.v1",
    "preimage": "hash_domain || 0x00 || canonical_semantic_identity_bytes",
    "output": "schedule_semantic_sha256"
  }
}
