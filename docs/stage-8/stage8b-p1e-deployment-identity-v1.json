{
  "schema_version": 1,
  "domain": "moex.stage8b.p1e.deployment-identity.v1",
  "service_identity": {
    "user": "moex-p1-paper",
    "group": "moex-p1-paper",
    "effective_uid_rule": "resolved-uid-of-moex-p1-paper-must-equal-process-euid",
    "effective_gid_rule": "resolved-gid-of-moex-p1-paper-must-equal-process-egid",
    "supplementary_deployment_groups_allowed": false
  },
  "paths": {
    "main_unit": "moex-finam-p1-paper.service",
    "bootstrap_unit": "moex-finam-p1-paper-bootstrap.service",
    "bootstrap_recovery_template_unit": "moex-finam-p1-paper-bootstrap-recover@.service",
    "binary": "/usr/local/libexec/moex/stage8b-p1-paper-supervisor",
    "config": "/etc/moex-finam-p1-paper/supervisor.json",
    "credential_source": "/etc/moex-finam-p1-paper/credentials/stage8b-p1-lifecycle.key",
    "credential_runtime": "CREDENTIALS_DIRECTORY/stage8b-p1-lifecycle.key",
    "durable_parent": "/var/lib/moex-finam-p1-paper",
    "mutable_state_directory": "/var/lib/moex-finam-p1-paper/state",
    "canonical_root": "/var/lib/moex-finam-p1-paper/state/identity-derived-root",
    "transaction_marker": "/var/lib/moex-finam-p1-paper/state/.stage8b-p1-first-boot-transaction-v3.json",
    "transaction_marker_temp": "/var/lib/moex-finam-p1-paper/state/.stage8b-p1-first-boot-transaction-v3.tmp",
    "accepted_receipt": "/var/lib/moex-finam-p1-paper/state/.stage8b-p1-first-boot-receipt-v2.json",
    "accepted_receipt_temp": "/var/lib/moex-finam-p1-paper/state/.stage8b-p1-first-boot-receipt-v2.tmp",
    "quarantine_directory": "/var/lib/moex-finam-p1-paper/state/.stage8b-p1-first-boot-quarantine"
  },
  "units": {
    "main": {
      "unit": "moex-finam-p1-paper.service",
      "mode": "run",
      "exec_start": "/usr/local/libexec/moex/stage8b-p1-paper-supervisor run /etc/moex-finam-p1-paper/supervisor.json"
    },
    "bootstrap": {
      "unit": "moex-finam-p1-paper-bootstrap.service",
      "mode": "bootstrap",
      "exec_start": "/usr/local/libexec/moex/stage8b-p1-paper-supervisor bootstrap /etc/moex-finam-p1-paper/supervisor.json CREATE_NEW_STAGE8B_P1_DURABLE_ROOT"
    },
    "bootstrap_recover": {
      "unit": "moex-finam-p1-paper-bootstrap-recover@.service",
      "mode": "bootstrap-recover",
      "exec_start": "/usr/local/libexec/moex/stage8b-p1-paper-supervisor bootstrap-recover /etc/moex-finam-p1-paper/supervisor.json %i RECOVER_EXISTING_STAGE8B_P1_FIRST_BOOT_V3"
    }
  },
  "shared_unit_contract": {
    "User": "moex-p1-paper",
    "Group": "moex-p1-paper",
    "UMask": "0077",
    "LoadCredential": "stage8b-p1-lifecycle.key:/etc/moex-finam-p1-paper/credentials/stage8b-p1-lifecycle.key",
    "NoNewPrivileges": true,
    "PrivateTmp": true,
    "ProtectSystem": "strict",
    "ProtectHome": true,
    "ReadOnlyPaths": ["/etc/moex-finam-p1-paper"],
    "ReadWritePaths": ["/var/lib/moex-finam-p1-paper/state"],
    "RestrictAddressFamilies": ["AF_UNIX"],
    "PrivateNetwork": true
  },
  "ownership_table": [
    {"object": "durable_parent", "path": "/var/lib/moex-finam-p1-paper", "owner": "root", "group": "moex-p1-paper", "mode": "0750", "created_by": "P1-f-installation", "service_create_allowed": false},
    {"object": "mutable_state_directory", "path": "/var/lib/moex-finam-p1-paper/state", "owner": "moex-p1-paper", "group": "moex-p1-paper", "mode": "0700", "created_by": "P1-f-installation", "service_create_allowed": false},
    {"object": "canonical_root", "path": "/var/lib/moex-finam-p1-paper/state/identity-derived-root", "owner": "moex-p1-paper", "group": "moex-p1-paper", "mode": "0700", "created_by": "bootstrap-service", "service_create_allowed": true},
    {"object": "journal", "path": "canonical_root/journal", "owner": "moex-p1-paper", "group": "moex-p1-paper", "mode": "0600", "created_by": "bootstrap-or-main-service", "service_create_allowed": true},
    {"object": "seal", "path": "canonical_root/recovery-seal", "owner": "moex-p1-paper", "group": "moex-p1-paper", "mode": "0600", "created_by": "bootstrap-or-main-service", "service_create_allowed": true},
    {"object": "transaction_marker", "path": "/var/lib/moex-finam-p1-paper/state/.stage8b-p1-first-boot-transaction-v3.json", "owner": "moex-p1-paper", "group": "moex-p1-paper", "mode": "0600", "created_by": "bootstrap-or-recovery-service", "service_create_allowed": true},
    {"object": "transaction_marker_temp", "path": "/var/lib/moex-finam-p1-paper/state/.stage8b-p1-first-boot-transaction-v3.tmp", "owner": "moex-p1-paper", "group": "moex-p1-paper", "mode": "0600", "created_by": "bootstrap-or-recovery-service", "service_create_allowed": true},
    {"object": "accepted_receipt", "path": "/var/lib/moex-finam-p1-paper/state/.stage8b-p1-first-boot-receipt-v2.json", "owner": "moex-p1-paper", "group": "moex-p1-paper", "mode": "0600", "created_by": "recovery-service", "service_create_allowed": true},
    {"object": "accepted_receipt_temp", "path": "/var/lib/moex-finam-p1-paper/state/.stage8b-p1-first-boot-receipt-v2.tmp", "owner": "moex-p1-paper", "group": "moex-p1-paper", "mode": "0600", "created_by": "recovery-service", "service_create_allowed": true},
    {"object": "quarantine_directory", "path": "/var/lib/moex-finam-p1-paper/state/.stage8b-p1-first-boot-quarantine", "owner": "moex-p1-paper", "group": "moex-p1-paper", "mode": "0700", "created_by": "P1-f-installation", "service_create_allowed": false},
    {"object": "quarantined_transaction_root", "path": "quarantine_directory/transaction-id", "owner": "moex-p1-paper", "group": "moex-p1-paper", "mode": "0700", "created_by": "recovery-service-rename-only", "service_create_allowed": true}
  ],
  "post_create_validation": [
    "open-parent-directory-fd-with-O_DIRECTORY-O_NOFOLLOW",
    "create-with-openat-O_CREAT-O_EXCL-O_NOFOLLOW-and-exact-mode",
    "fstat-new-fd",
    "st_uid-equals-resolved-service-uid",
    "st_gid-equals-resolved-service-gid",
    "st_nlink-equals-1",
    "file-type-and-mode-equal-ownership-table",
    "group-and-world-write-bits-absent",
    "fsync-file-then-fsync-parent"
  ],
  "alternate_identity_policy": "any-second-deployment-uid-gid-or-alternate-binary-config-credential-mutable-parent-is-a-pre-mutation-config-error"
}
