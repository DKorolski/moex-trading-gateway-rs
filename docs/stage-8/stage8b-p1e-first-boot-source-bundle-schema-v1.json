{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moex.stage8b.p1e.first-boot-source-bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "operational_identity_sha256", "runtime_profile_sha256", "instrument_map_fingerprint_sha256", "source_bundle_generation", "captured_at_utc", "broker_truth", "history_provenance", "history_bars", "riskgate_history", "candidate"],
  "properties": {
    "schema_version": {"const": 1},
    "domain": {"const": "moex.stage8b.p1e.first-boot-source-bundle.v1"},
    "operational_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_profile_sha256": {"const": "dd5a211e708db0d40175d19ed1eeb51db26497d344a553b41d7afbfdddde0ef6"},
    "instrument_map_fingerprint_sha256": {"const": "ba4e7b1190dc2686559b6d7c0df0185e96a10dfac6b13f6a582a349b14198558"},
    "source_bundle_generation": {"type": "integer", "minimum": 1},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "broker_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_at_utc", "account_id", "instrument", "target_position_qty", "target_positions_complete", "target_active_orders_count", "account_active_orders_count", "active_orders_complete", "instrument_price_step"],
      "properties": {
        "checked_at_utc": {"type": "string", "format": "date-time"},
        "account_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "instrument": {"const": "IMOEXF@RTSX"},
        "target_position_qty": {"const": "0"},
        "target_positions_complete": {"const": true},
        "target_active_orders_count": {"const": 0},
        "account_active_orders_count": {"const": 0},
        "active_orders_complete": {"const": true},
        "instrument_price_step": {"const": "0.5"}
      }
    },
    "history_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_mode", "source_timeframe_sec", "target_timeframe_sec", "aggregation_complete", "gap_absence_proven"],
      "properties": {
        "source_mode": {"const": "finam_derived_m1_to_m10"},
        "source_timeframe_sec": {"const": 60},
        "target_timeframe_sec": {"const": 600},
        "aggregation_complete": {"const": true},
        "gap_absence_proven": {"const": true}
      }
    },
    "history_bars": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/history_bar"}
    },
    "riskgate_history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_mode", "state_generation", "history_bars_sha256", "session_observations_sha256", "session_observations"],
      "properties": {
        "source_mode": {"const": "source-compatible-high180-shadow-history-v1"},
        "state_generation": {"const": "runtime-ledger-v1"},
        "history_bars_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "session_observations_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "session_observations": {
          "type": "array",
          "minItems": 120,
          "items": {"$ref": "#/$defs/riskgate_session_observation"}
        }
      }
    },
    "candidate": {"$ref": "#/$defs/candidate_bar"}
  },
  "$defs": {
    "ohlcv": {
      "type": "object",
      "required": ["instrument", "timeframe_sec", "close_time_utc", "open", "high", "low", "close", "volume", "is_final"],
      "properties": {
        "instrument": {"const": "IMOEXF@RTSX"},
        "timeframe_sec": {"const": 600},
        "close_time_utc": {"type": "integer", "minimum": 1},
        "open": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "high": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "low": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "close": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "volume": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "is_final": {"const": true}
      }
    },
    "history_bar": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/ohlcv"},
        {"type": "object", "properties": {"origin": {"const": "history"}}, "required": ["origin"]}
      ]
    },
    "candidate_bar": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/ohlcv"},
        {"type": "object", "properties": {"origin": {"const": "replay"}, "semantic_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "required": ["origin", "semantic_id_sha256"]}
      ]
    },
    "riskgate_session_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_date", "shadow_pnl_points", "shadow_trade_count"],
      "properties": {
        "session_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "shadow_pnl_points": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        "shadow_trade_count": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    }
  }
}
